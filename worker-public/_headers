# Cloudflare Workers Static Assets response headers (mirrored to worker-public/).
# Only URLs that are content-addressed may be immutable:
# - Vite output under vite-dist/assets/ carries a content hash in its file name.
# - The stylesheets and classic entry scripts below are referenced only as
#   `<path>?v=<sha256 of the file>` by the generated HTML, so a changed file is
#   always requested under a new URL. _headers matches the path only.
# Everything else (HTML, assets/**, data/**, optional registries, the gacha and
# leaderboard stylesheets versioned by the startup token) keeps the default
# revalidation.
/vite-dist/assets/*
  Cache-Control: public, max-age=31536000, immutable
