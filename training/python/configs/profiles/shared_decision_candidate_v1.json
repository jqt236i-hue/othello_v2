{
  "schemaVersion": "training_profile.v1",
  "name": "shared_decision_candidate_v1",
  "description": "Candidate-only card-game policy/card/target/value distillation from the current shared teacher. No promotion or browser deployment; live CPU paired evaluation is required separately.",
  "runTagPrefix": "shared_decision_candidate_v1",
  "syncCpuLv6SharedTeacher": true,
  "paths": {
    "runsDir": "data/runs/shared_decision_candidate_v1",
    "modelsDir": "data/runs/shared_decision_candidate_v1/candidates"
  },
  "bootstrap": {
    "sourcePolicyTable": "data/runs/shared_decision_candidate_v1/baseline/policy-table.json",
    "sourceOnnxModel": "data/runs/shared_decision_candidate_v1/baseline/policy-net.onnx",
    "sourceOnnxMeta": "data/runs/shared_decision_candidate_v1/baseline/policy-net.onnx.meta.json",
    "copyPromotedPolicyTable": true,
    "copyPromotedOnnxModel": true,
    "copyPromotedOnnxMeta": true,
    "useCopiedPolicyTableAsBootstrap": true,
    "autoResumeLatestCheckpoint": false
  },
  "preflight": { "enabled": true, "strict": false, "allowArtifacts": true, "checkWindow": true },
  "trainCycleArgs": [
    "--iterations", "3", "--max-hours", "12",
    "--train-games", "768", "--eval-games", "160",
    "--selfplay-jobs", "6", "--selfplay-resume-chunk-size", "96",
    "--adoption-jobs", "4", "--onnx-gate-jobs", "2",
    "--seed", "9052026", "--seed-stride", "10000", "--eval-seed-offset", "1000000",
    "--max-plies", "220", "--with-cards", "--no-selfplay-white-deck-code", "--card-usage-rate", "0.6",
    "--selfplay-card-usage-rate-jitter", "0.1",
    "--selfplay-policy-mix-rate", "1", "--selfplay-policy-model-pool-size", "1",
    "--selfplay-policy-current-anchor-rate", "1",
    "--selfplay-use-promoted-model-only", "--selfplay-candidate-admission", "promoted-only",
    "--selfplay-tactical-depth-opening", "4", "--selfplay-tactical-depth-mid", "5",
    "--selfplay-tactical-depth-end", "7", "--selfplay-tactical-beam-width", "8",
    "--train-card-every", "1", "--train-target-head", "--train-target-every", "1",
    "--train-value-head", "--train-value-every", "1",
    "--onnx-hidden-size", "256", "--onnx-batch-size", "512",
    "--onnx-device", "cuda", "--onnx-epochs", "80", "--onnx-lr", "0.0003",
    "--onnx-val-split", "0.2", "--onnx-val-split-mode", "grouped-game",
    "--onnx-early-stop-min-epochs", "12", "--onnx-early-stop-patience", "8",
    "--onnx-early-stop-min-delta", "0.0001", "--onnx-early-stop-monitor", "val_loss",
    "--onnx-early-stop-smoothing-window", "3", "--onnx-log-interval-steps", "20",
    "--onnx-card-no-action-weight", "1", "--onnx-card-class-balance-power", "0.25",
    "--onnx-winner-sample-boost", "0.2", "--onnx-loser-sample-weight", "1",
    "--onnx-draw-sample-weight", "1", "--onnx-tactical-miss-sample-boost", "0.25",
    "--min-visits", "2", "--shape-immediate", "0.25",
    "--carry-over-checkpoint", "--no-onnx-resume-optimizer",
    "--gate-final-iteration-only", "--adoption-use-anchor-baseline",
    "--quality-gate", "--quality-gate-games", "64", "--quality-gate-seed-count", "3",
    "--quality-gate-seed-offset", "2000000", "--quality-gate-seed-stride", "10000",
    "--quality-gate-threshold", "0.01", "--quality-gate-confidence-level", "0.99",
    "--quality-gate-min-lower-bound", "0", "--quality-gate-min-seed-uplift", "0",
    "--quality-gate-min-seed-pass-count", "3",
    "--quick-games", "48", "--final-games", "192", "--threshold", "0.03",
    "--adoption-seed-count", "3", "--adoption-seed-stride", "10000",
    "--adoption-final-seed-offset", "3000000", "--quick-adoption-seed-offset", "1500000",
    "--adoption-confidence-level", "0.99", "--adoption-min-lower-bound", "0",
    "--adoption-min-seed-uplift", "0", "--adoption-min-seed-pass-count", "3",
    "--no-onnx-gate", "--promotion-mode", "strict",
    "--no-promote", "--no-deploy-promoted-to-root"
  ]
}
