{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false
  },
  "include": [
    "game/**/*.ts",
    "ui/**/*.ts",
    "shared/**/*.ts",
    "constants/**/*.ts",
    "workers/**/*.ts",
    "scripts/**/*.ts",
    "story/**/*.ts",
    "cards/**/*.ts",
    "cpu/**/*.ts",
    "src/**/*.ts",
    "utils/**/*.ts",
    "shared-constants.ts",
    "game-events.ts",
    "sound-engine.ts",
    "ui.ts",
    "is-env-capable.ts",
    "card-system.ts",
    "fix_registry_turnmanager.ts",
    "analyze-selfplay-moves.ts",
    "analyze-destroy-cycle.ts",
    "analyze-crystal-stone.ts",
    "analyze-crystal-stone-quiet.ts",
    "analyze-trap-will.ts"
  ],
  "exclude": [
    "node_modules",
    "worker-public",
    "coverage",
    "dist",
    "**/__pycache__/**",
    "ai/**/*",
    "**/*.generated.js",
    "test/**/*",
    "tests/**/*"
  ]
}
