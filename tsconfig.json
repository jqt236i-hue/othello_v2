{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    "types": ["node", "jest"]
  },
    "include": [
      "game/**/*",
      "ui/**/*",
      "shared/**/*",
      "workers/**/*",
      "scripts/**/*",
      "cards/**/*",
      "test/**/*",
      "tests/**/*",
      "src/**/*",
      "utils/**/*.ts"
    ],
  "exclude": [
    "node_modules",
    "worker-public",
    "coverage",
    "dist",
    "**/__pycache__/**",
    "ai/**/*"
  ]
}
