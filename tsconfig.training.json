{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "noImplicitThis": false,
    "alwaysStrict": false,
    "moduleDetection": "force",
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "training/scripts/**/*.ts",
    "training/engine/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "worker-public",
    "coverage",
    "dist",
    "**/__pycache__/**",
    "training/tests/**/*"
  ]
}
