{
  "name": "card-reversi",
  "version": "1.0.0",
  "description": "Card Reversi Game",
  "main": "index.html",
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck:training",
    "typecheck:ts-only": "tsc -p tsconfig.ts-only.json --pretty false && npm run typecheck:training",
    "typecheck:watch": "tsc --noEmit --watch",
    "build:ts": "tsc -p tsconfig.build.json && npm run typecheck:training && node scripts/build-training-cli.js",
    "build:browser": "npm run build:ts && node dist/scripts/build-module-registry.js",
    "serve": "node scripts/serve-with-fallback.js",
    "match:server": "npm run build:ts && node scripts/local-match-server.js",
    "match:server:net": "npm run build:ts && node scripts/local-match-server.js --host 0.0.0.0 --port 8787",
    "match:check": "node scripts/match-network-smoke.js",
    "match:turnstart-browser-check": "npm run build:ts && node dist/scripts/network-turn-start-browser-check.js",
    "match:playback-board-writer-check": "npm run build:ts && node dist/scripts/playback-board-writer-browser-check.js",
    "match:boot-performance-check": "npm run build:browser && node dist/scripts/browser-boot-performance-check.js",
    "baseline:browser-modernization": "npm run build:browser && node dist/scripts/capture-browser-modernization-baseline.js",
    "perf:network-special-stone": "npm run build:browser && node scripts/perf/measure-network-special-stone-late-game.js",
    "match:ui-control-smoke": "npm run build:browser && node dist/scripts/browser-ui-control-smoke.js",
    "match:endgame-check": "npm run build:ts && node dist/scripts/network-endgame-smoke.js",
    "test:network:parity": "jest --runInBand --runTestsByPath test\\ui.network-client.publish-base-version.test.ts test\\ui.network-client.reconnect-sync.test.ts test\\ui.network-client.apply-coordinator.test.ts test\\ui.network-client.sound-dedupe.test.ts test\\ui.network-client.result-sync.test.ts test\\ui.network-client.action-bridge-next-snapshot.test.ts test\\ui.network-client.trap-deferred-publish.test.ts test\\ui.network-work-will-followup-placement.test.ts test\\ui.network-snapshot.single-writer-baseline.test.ts test\\ui.network-snapshot.pending-presentation-reconcile.test.ts test\\ui.network-snapshot.move-source-empty.test.ts test\\workers.match-publish-sanitize.test.ts test\\workers.match-publish-idempotency.test.ts test\\workers.match-pending-effect-id.test.ts test\\workers.match-movement-selection.test.ts test\\workers.match-card-pattern-parity.test.ts test\\workers.match-card-selector-preload.test.ts test\\workers.match-network-parity-missing-types.test.ts test\\workers.match-condemn-visibility.test.ts test\\workers.match-reveal-hand-visibility.test.ts test\\workers.match-trap-visibility.test.ts test\\workers.match-fate-will-authority.test.ts test\\workers.match-stream-sse.test.ts test\\workers.match-leave-token-revocation.test.ts test\\network.authority-path-hardening.test.ts test\\network.playback-event-assembly.contract.test.ts test\\utils.match-authority.publish-response.test.ts test\\local-match-server.publish-contract.test.ts test\\local-match-server.leave-contract.test.ts test\\ui.match-mode.network-button.test.ts test\\ui.animation-utils.hand-fallback.test.ts test\\ui.animation-feedback-events.sound-keys.test.ts test\\ui.animation-engine.test.ts test\\ui.animation-engine.move-variants.test.ts",
    "test:match:parity": "jest --runInBand --runTestsByPath test\\match-runtime-parity.test.ts test\\network.authority-path-hardening.test.ts test\\workers.match-card-pattern-parity.test.ts test\\workers.match-condemn-visibility.test.ts test\\workers.match-reveal-hand-visibility.test.ts test\\workers.match-trap-visibility.test.ts test\\workers.match-fate-will-authority.test.ts test\\network.playback-event-assembly.contract.test.ts test\\local-match-server.publish-contract.test.ts test\\workers.match-publish-idempotency.test.ts test\\workers.match-pending-effect-id.test.ts",
    "check:generated-network-surface": "npm run build:ts && node dist/scripts/check-generated-network-surface.js",
    "check:artifact-retention": "npm run build:ts && node dist/scripts/check-artifact-retention.js",
    "check:worker-mirror": "npm run build:ts && node dist/scripts/check-worker-mirror.js",
    "worker:prepare": "npm run build:ts && node scripts/check-asset-file-case.js && node dist/scripts/check-worker-runtime-preload.js && node scripts/prepare-worker-assets.js",
    "worker:dev": "npm run worker:prepare && npx wrangler dev",
    "worker:bundle:smoke": "node dist/scripts/worker-bundle-smoke.js",
    "worker:deploy": "npm run worker:prepare && npm run worker:bundle:smoke && npx wrangler deploy",
    "llm:download:nemotron": "node scripts/download-nemotron-gguf.js",
    "llm:commentary:server": "node scripts/local-cpu-commentary-server.js",
    "test:jest:changed": "jest --onlyChanged",
    "test:jest": "jest --runInBand",
    "typecheck:training": "tsc -p tsconfig.training.json --pretty false",
    "check:window": "node scripts/check-window-usage.js",
    "check:dependency-boundaries": "jest --runInBand --runTestsByPath test\\refactor.dependency-boundary.test.ts",
    "check:asset-case": "node scripts/check-asset-file-case.js",
    "test:jest:coverage": "jest --runInBand --coverage",
    "test:jest:noanim": "node scripts/run-jest-noanim.js --runInBand",
    "test:jest:noanim:coverage": "node scripts/run-jest-noanim.js --runInBand --coverage",
    "selfplay:generate": "npm run build:ts && node scripts/generate-selfplay-data.js",
    "selfplay:generate:parallel": "npm run build:ts && node scripts/generate-selfplay-data-parallel.js",
    "selfplay:benchmark": "node scripts/benchmark-selfplay-policy.js",
    "selfplay:adoption-check": "node scripts/benchmark-policy-adoption.js",
    "selfplay:onnx-gate": "node scripts/benchmark-policy-onnx-gate.js",
    "selfplay:promote-model": "node scripts/promote-policy-model.js",
    "selfplay:clean-artifacts": "node scripts/clean-selfplay-artifacts.js --apply",
    "selfplay:preflight": "node scripts/preflight-selfplay-training.js --check-window",
    "selfplay:prepare-foundation": "node scripts/clean-selfplay-artifacts.js --apply && node scripts/preflight-selfplay-training.js --strict --check-window",
    "selfplay:init-foundation:deepcfr": "node scripts/init-deepcfr-foundation.js",
    "selfplay:preflight:deepcfr": "node scripts/preflight-deepcfr-training.js --check-window",
    "selfplay:prepare-foundation:deepcfr": "node scripts/clean-selfplay-artifacts.js --apply --keep-deployed && node scripts/init-deepcfr-foundation.js && node scripts/preflight-deepcfr-training.js --strict --check-window",
    "selfplay:resolve-profile": "node scripts/resolve-training-profile.js",
    "selfplay:train-profile": "node scripts/run-selfplay-training-profile.js",
    "selfplay:monitor": "node scripts/monitor-selfplay-training-run.js",
    "selfplay:train-profile:production": "node scripts/run-selfplay-training-profile.js --profile production_v2",
    "selfplay:train-profile:production:v3": "node scripts/run-selfplay-training-profile.js --profile production_v3",
    "selfplay:foundation-bootstrap": "node scripts/run-selfplay-training-profile.js --profile foundation_bootstrap_v1",
    "selfplay:mine-hardcases": "node scripts/run-selfplay-training-profile.js --profile hardcase_mining_v2",
    "selfplay:retrain-hardcases": "node scripts/run-selfplay-training-profile.js --profile retrain_from_hardcases_v1",
    "selfplay:train-preset:cards": "node scripts/run-selfplay-training-preset.js --profile cards_v1",
    "selfplay:export-teacher": "node scripts/export-teacher-solutions.js",
    "selfplay:train-onnx": ".\\.venv\\Scripts\\python.exe .\\training\\python\\train_policy_onnx.py",
    "selfplay:train-card": ".\\.venv\\Scripts\\python.exe .\\training\\python\\train_card_onnx.py",
    "selfplay:train-deepcfr": ".\\.venv\\Scripts\\python.exe .\\training\\python\\train_deepcfr_onnx.py",
    "selfplay:train-cycle": "node scripts/run-selfplay-training-cycle.js",
    "othello:onnx-loop": "node scripts/run-othello-onnx-training-loop.js",
    "generate:catalog": "node scripts/generate-catalog.js",
    "generate:observation-gacha-catalog": "node scripts/generate-observation-gacha-catalog.js",
    "generate:gacha-hand-catalog": "node scripts/generate-observation-gacha-catalog.js",
    "generate:asset-manifest": "node scripts/generate-asset-manifest.js",
    "generate:card-art-map": "node scripts/generate-card-art-map.js",
    "test:visual": "node tests/visual-regression/run-visual-check.js",
    "checkall": "node scripts/run-all-checks.js",
    "pretest": "npm run checkall",
    "test": "npm run test:jest",
    "test:quick": "npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "onnxruntime-web": "^1.22.0"
  },
  "jest": {
    "testEnvironment": "node",
    "preset": "ts-jest",
    "transform": {
      "^.+\\.(ts|tsx)$": "<rootDir>/tests/ts-jest-strip-shebang-transform.cjs",
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "setupFiles": [
      "<rootDir>/tests/jest.setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest.afterenv.js"
    ],
    "collectCoverageFrom": [
      "game/**/*.(js|ts)",
      "!**/vendor/**"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.ts",
      "<rootDir>/training/tests/**/*.test.ts",
      "<rootDir>/game/ai/__tests__/**/*.test.ts",
      "<rootDir>/scripts/__tests__/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/dist/",
      "<rootDir>/01-CARD-OTHELLO/",
      "<rootDir>/.wrangler/",
      "<rootDir>/worker-public/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.wrangler/",
      "<rootDir>/worker-public/"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json",
      "node"
    ]
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "http-server": "^14.1.1",
    "jest": "^29.6.1",
    "jsdom": "^22.1.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.57.0",
    "pngjs": "^7.0.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}
