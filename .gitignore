# Dependencies
node_modules/

# Build outputs
dist/
/vite-dist/
coverage/
# Large generated browser/Worker outputs. Regenerate with `npm run build:vite`
# (registry) and `npm run worker:prepare` (Worker mirror); never commit them.
/public/module-registry*.js
/worker-public/

# Cloudflare Wrangler cache
.wrangler/

# Playwright MCP artifacts
.playwright-mcp/page-*.png
.playwright-mcp/*.txt
.playwright-mcp/*.yml

# Python cache
**/__pycache__/

# Generated ML artifacts (safe to regenerate)
logs/
reports/
checkpoints*/
final-dataset/
training-data*/
selfplay-data*/
deploy_stage/
out-test/
test-batch/
test-curated/
test-output/
test-results/
test-speed*/
replays/
weakness/
policies/
_archive/
playwright-report/

# Temporary files
*.log
*.tmp
*.cache
tmp/
tmp-*
/.codex-podium-*.json
/session-ses_*.md
/tmp_*.json

# Large archives
*.zip
*.tar.gz

# Test artifacts
breeding-*.png
test_run_output.txt
# Visual regression failure diagnostics. The tracked baseline is the test input.
/tests/visual-regression/current-board.png
/tests/visual-regression/diff-board.png

# Disposable investigation output. Durable documentation belongs in docs/ and
# shipped images belong in assets/; artifacts/ must never become source input.
/artifacts/

# Debug Python scripts
check_*.py
debug_*.py
analyze_*.py
show_*.py
step_*.py
test_*.py

# Editor/IDE
.vscode/
.idea/
.codegraph/
*.swp
*.swo
.venv/

# OS
.DS_Store
Thumbs.db
*.lnk

# IMPORTANT: Do NOT ignore these (required for re-training/browser game dependencies)
!ai/train/**
!ai/deepcfr/**
!ai/ismcts/**

# Ignore locally generated distribution patches
patches/*.patch
output/battle-package/
output/battle-verification/
output/godot-port-preparation/
output/godot-source-*/
output/card-reversi-battle-*.tgz

# Ignore data directory for machine learning
data/**
!data/models/
!data/models/othello/
!data/models/model-assets.json
!data/models/policy-net.onnx
!data/models/policy-net.onnx.meta.json
!data/models/policy-table.json
!data/models/othello/policy-table.json
!data/models/othello/policy-value.onnx
!data/models/othello/policy-value.onnx.meta.json
!data/models/othello/value-table.json

# Experiment outputs, ML data and Blender work files (regenerable or authoring-only; too large for the repo)
/output/
/othello-ai/data/
/worker-public/data/
/assets/images/special-cards/characters/*_reference/blender_model*/

# training/tests の一時出力（selfplay.clean-artifacts.test などが作る）
/training/data/
