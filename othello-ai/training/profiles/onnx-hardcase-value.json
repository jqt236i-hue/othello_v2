{
  "schemaVersion": "othello_onnx_training_profile.v1",
  "description": "White Lv6 focused ONNX lane using the browser runtime gate path, bounded hardcase replay, and champion warm start.",
  "args": {
    "trainGames": 512,
    "evalGames": 128,
    "jobs": 6,
    "datasetMaxRecords": 220000,
    "replayWindow": 16,
    "hardcaseReplayWindow": 4,
    "hardcaseReplayWeight": 3,
    "hardcaseMaxRecords": 18000,
    "epochs": 10,
    "batchSize": 1024,
    "hiddenDim": 384,
    "depth": 5,
    "dropout": 0.04,
    "valueLossWeight": 1.1,
    "policyLossWeight": 0.6,
    "whiteSampleWeight": 3.4,
    "blackSampleWeight": 1,
    "gatePairs": 24,
    "championGatePairs": 28,
    "gateOpeningPlies": 8,
    "gateMinWhitePointRate": 0.58,
    "gateMinWhiteDiscDiff": 0,
    "championGateMinPointRate": 0.52,
    "championGateMinWhitePointRate": 0.56,
    "championGateMinWhiteDiscDiff": 0,
    "heuristicRerankWeight": 3,
    "policyWeight": 0.75,
    "topK": 8,
    "whiteSafetyMultiplier": 1.45,
    "openingPliesMin": 2,
    "openingPliesMax": 11,
    "openingPreferredPlayer": "white",
    "openingPreferredPlayerRate": 1,
    "openingSeedBankSampleRate": 0.75,
    "depthOpening": 2,
    "depthMid": 2,
    "depthEnd": 3,
    "exactSolveEmpties": 8,
    "explorationOpening": 0.12,
    "explorationMid": 0.09,
    "explorationEnd": 0,
    "initOnnx": "othello-ai/data/models/policy-value.onnx.champion.onnx",
    "runtimeModelOut": "data/models/othello/policy-value.onnx",
    "runtimeMetaOut": "data/models/othello/policy-value.onnx.meta.json",
    "championModelOut": "othello-ai/data/models/policy-value.onnx.champion.onnx",
    "championMetaOut": "othello-ai/data/models/policy-value.onnx.champion.onnx.meta.json"
  }
}
