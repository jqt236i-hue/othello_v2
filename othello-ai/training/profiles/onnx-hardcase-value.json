{
  "schemaVersion": "othello_onnx_training_profile.v1",
  "description": "White Lv6 focused ONNX search-distillation lane with hardcase replay and champion warm start.",
  "args": {
    "trainGames": 512,
    "evalGames": 128,
    "jobs": 6,
    "datasetMaxRecords": 220000,
    "replayWindow": 10,
    "hardcaseReplayWindow": 5,
    "hardcaseReplayWeight": 4,
    "hardcaseMaxRecords": 24000,
    "epochs": 10,
    "batchSize": 1024,
    "hiddenDim": 384,
    "depth": 5,
    "dropout": 0.04,
    "valueLossWeight": 1.1,
    "policyLossWeight": 0.45,
    "whiteSampleWeight": 3.4,
    "blackSampleWeight": 1,
    "gatePairs": 12,
    "championGatePairs": 12,
    "gateOpeningPlies": 10,
    "gateMinWhitePointRate": 0.58,
    "gateMinWhiteDiscDiff": 0,
    "championGateMinPointRate": 0.52,
    "championGateMinWhitePointRate": 0.56,
    "championGateMinWhiteDiscDiff": -1,
    "heuristicRerankWeight": 3.2,
    "policyWeight": 0.45,
    "topK": 8,
    "whiteSafetyMultiplier": 1.55,
    "openingPliesMin": 4,
    "openingPliesMax": 14,
    "openingPreferredPlayer": "white",
    "openingPreferredPlayerRate": 1,
    "openingSeedBankSampleRate": 0.8,
    "depthOpening": 2,
    "depthMid": 2,
    "depthEnd": 3,
    "exactSolveEmpties": 8,
    "explorationOpening": 0.16,
    "explorationMid": 0.06,
    "explorationEnd": 0,
    "initOnnx": "othello-ai/data/models/policy-value.onnx.champion.onnx",
    "runtimeModelOut": "data/models/othello/policy-value.onnx",
    "runtimeMetaOut": "data/models/othello/policy-value.onnx.meta.json",
    "championModelOut": "othello-ai/data/models/policy-value.onnx.champion.onnx",
    "championMetaOut": "othello-ai/data/models/policy-value.onnx.champion.onnx.meta.json"
  }
}
