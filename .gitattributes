*.pdf binary
*.png binary
*.pptx binary
public/vendor/*.min.js binary
worker-public/public/vendor/*.min.js binary
worker-public/vite-dist/assets/* binary

# Browser and runtime code generation must see identical source bytes on every OS.
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsx text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.svg text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Preserve original runtime model bytes so their hashes survive every checkout.
data/models/policy-table.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
data/models/policy-net.onnx.meta.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
data/models/othello/policy-table.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
data/models/othello/value-table.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
data/models/othello/policy-value.onnx.meta.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
